selectActiveByStore:
SELECT * FROM app_user
WHERE tenant_id = :tenantId AND store_id = :storeId AND is_active = 1 AND deleted_at IS NULL;

selectById:
SELECT * FROM app_user WHERE id = :id AND deleted_at IS NULL;

insert:
INSERT INTO app_user (
    id, tenant_id, store_id, full_name, username, pin_hash, pin_salt, role_code,
    is_active, must_change_pin, locked_until, failed_attempts,
    created_at, updated_at, deleted_at, revision, origin_device_id, server_seq
) VALUES (
    ?, ?, ?, ?, ?, ?, ?, ?,
    1, 0, NULL, 0,
    ?, ?, NULL, 1, ?, NULL
);

recordFailedAttempt:
UPDATE app_user
SET failed_attempts = failed_attempts + 1, locked_until = :lockedUntil, updated_at = :updatedAt, revision = revision + 1
WHERE id = :id;

resetFailedAttempts:
UPDATE app_user
SET failed_attempts = 0, locked_until = NULL, updated_at = :updatedAt, revision = revision + 1
WHERE id = :id;
