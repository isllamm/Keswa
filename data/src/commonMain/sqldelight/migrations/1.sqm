-- Keswa schema v1 — see docs/data-model.md for the full design rationale.
--
-- Universal column contract (mutable tables): id, tenant_id, store_id, created_at, updated_at,
-- deleted_at, revision, origin_device_id, server_seq.
-- Append-only tables (ledgers, audit, outbox) omit updated_at/deleted_at/revision — they are
-- never modified, only appended to. See ADR-001, ADR-002, ADR-003, ADR-007.

-- ============================================================================
-- Tenancy, stores, locations, devices
-- ============================================================================

CREATE TABLE tenant (
    id                  TEXT PRIMARY KEY NOT NULL,
    name                TEXT NOT NULL,
    default_currency_code TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER
);

CREATE TABLE store (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    code                TEXT NOT NULL,
    name                TEXT NOT NULL,
    address             TEXT,
    phone               TEXT,
    timezone            TEXT NOT NULL,
    is_active           INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (tenant_id) REFERENCES tenant(id)
);
CREATE UNIQUE INDEX store_tenant_code ON store(tenant_id, code);

CREATE TABLE location (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    code                TEXT NOT NULL,
    name                TEXT NOT NULL,
    kind                TEXT NOT NULL CHECK (kind IN ('SALES_FLOOR','STOCKROOM','TRANSIT','SUPPLIER','CUSTOMER','ADJUSTMENT')),
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (store_id) REFERENCES store(id)
);
CREATE INDEX location_store ON location(tenant_id, store_id, deleted_at);

CREATE TABLE device (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    label               TEXT NOT NULL,
    os                  TEXT NOT NULL,
    app_version         TEXT NOT NULL,
    registered_at       INTEGER NOT NULL,
    last_seen_at        INTEGER NOT NULL
);

-- ============================================================================
-- Users, roles, permissions
-- ============================================================================

CREATE TABLE app_user (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    full_name           TEXT NOT NULL,
    username            TEXT NOT NULL,
    pin_hash            TEXT NOT NULL,
    pin_salt            TEXT NOT NULL,
    role_code           TEXT NOT NULL CHECK (role_code IN ('OWNER','MANAGER','CASHIER','STOCK_CLERK')),
    is_active           INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    must_change_pin     INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    locked_until        INTEGER,
    failed_attempts     INTEGER NOT NULL DEFAULT 0,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (store_id) REFERENCES store(id)
);
CREATE UNIQUE INDEX app_user_tenant_username ON app_user(tenant_id, username);

CREATE TABLE role_permission (
    role_code           TEXT NOT NULL,
    permission_code     TEXT NOT NULL,
    PRIMARY KEY (role_code, permission_code)
);

-- ============================================================================
-- Catalog: products, options, variants, barcodes
-- ============================================================================

CREATE TABLE category (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    name_ar             TEXT NOT NULL,
    name_en             TEXT,
    parent_id           TEXT,
    position            INTEGER NOT NULL DEFAULT 0,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (parent_id) REFERENCES category(id)
);
CREATE INDEX category_tenant ON category(tenant_id, deleted_at);

CREATE TABLE brand (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    name_ar             TEXT NOT NULL,
    name_en             TEXT,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER
);
CREATE INDEX brand_tenant ON brand(tenant_id, deleted_at);

CREATE TABLE product (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    code                TEXT NOT NULL,
    name_ar             TEXT NOT NULL,
    name_en             TEXT,
    name_sort           TEXT NOT NULL,
    category_id         TEXT,
    brand_id            TEXT,
    supplier_default_id TEXT,
    description         TEXT,
    is_active           INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    track_stock         INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    tax_rate_bp         INTEGER NOT NULL DEFAULT 0,
    image_path          TEXT,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (category_id) REFERENCES category(id),
    FOREIGN KEY (brand_id) REFERENCES brand(id)
);
CREATE UNIQUE INDEX product_tenant_code ON product(tenant_id, code);
CREATE INDEX product_tenant_sort ON product(tenant_id, deleted_at, name_sort);

CREATE TABLE product_option (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    product_id          TEXT NOT NULL,
    name_ar             TEXT NOT NULL,
    name_en             TEXT,
    position            INTEGER NOT NULL DEFAULT 0,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (product_id) REFERENCES product(id)
);
CREATE INDEX product_option_product ON product_option(product_id, deleted_at);

CREATE TABLE product_option_value (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    option_id           TEXT NOT NULL,
    value_ar            TEXT NOT NULL,
    value_en            TEXT,
    position            INTEGER NOT NULL DEFAULT 0,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (option_id) REFERENCES product_option(id)
);
CREATE INDEX product_option_value_option ON product_option_value(option_id, deleted_at);

CREATE TABLE product_variant (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    product_id          TEXT NOT NULL,
    sku                 TEXT NOT NULL,
    name_suffix         TEXT,
    cost_minor          INTEGER NOT NULL DEFAULT 0,
    currency_code       TEXT NOT NULL,
    is_active           INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    weight_grams        INTEGER,
    position            INTEGER NOT NULL DEFAULT 0,
    cost_rounding_minor INTEGER NOT NULL DEFAULT 0,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (product_id) REFERENCES product(id)
);
CREATE UNIQUE INDEX product_variant_tenant_sku ON product_variant(tenant_id, sku);
CREATE INDEX product_variant_product ON product_variant(product_id, deleted_at);

CREATE TABLE variant_option_value (
    variant_id          TEXT NOT NULL,
    option_value_id     TEXT NOT NULL,
    PRIMARY KEY (variant_id, option_value_id),
    FOREIGN KEY (variant_id) REFERENCES product_variant(id),
    FOREIGN KEY (option_value_id) REFERENCES product_option_value(id)
);

CREATE TABLE barcode (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    variant_id          TEXT NOT NULL,
    code                TEXT NOT NULL,
    kind                TEXT NOT NULL CHECK (kind IN ('EAN13','UPC','CODE128','INTERNAL','SUPPLIER')),
    is_primary          INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (variant_id) REFERENCES product_variant(id)
);
CREATE UNIQUE INDEX barcode_tenant_code ON barcode(tenant_id, code);
CREATE INDEX barcode_variant ON barcode(variant_id, deleted_at);

-- ============================================================================
-- Pricing
-- ============================================================================

CREATE TABLE price_list (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    code                TEXT NOT NULL,
    name_ar             TEXT NOT NULL,
    channel_code        TEXT NOT NULL CHECK (channel_code IN ('RETAIL','WHOLESALE','STAFF','ONLINE')),
    currency_code       TEXT NOT NULL,
    valid_from          INTEGER,
    valid_to            INTEGER,
    priority            INTEGER NOT NULL DEFAULT 0,
    is_active           INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (store_id) REFERENCES store(id)
);
CREATE UNIQUE INDEX price_list_tenant_code ON price_list(tenant_id, code);

CREATE TABLE price_list_item (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    price_list_id       TEXT NOT NULL,
    variant_id          TEXT NOT NULL,
    price_minor         INTEGER NOT NULL,
    min_qty             INTEGER NOT NULL DEFAULT 1,
    currency_code       TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (price_list_id) REFERENCES price_list(id),
    FOREIGN KEY (variant_id) REFERENCES product_variant(id)
);
CREATE INDEX price_list_item_lookup ON price_list_item(price_list_id, variant_id, deleted_at);

CREATE TABLE customer_price_list (
    customer_id         TEXT NOT NULL,
    price_list_id       TEXT NOT NULL,
    PRIMARY KEY (customer_id, price_list_id),
    FOREIGN KEY (price_list_id) REFERENCES price_list(id)
);

-- ============================================================================
-- Inventory: append-only ledger + materialized levels
-- ============================================================================

CREATE TABLE stock_movement (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    occurred_at         INTEGER NOT NULL,
    variant_id          TEXT NOT NULL,
    from_location_id    TEXT NOT NULL,
    to_location_id      TEXT NOT NULL,
    qty                 INTEGER NOT NULL CHECK (qty > 0),
    unit_cost_minor     INTEGER,
    currency_code       TEXT,
    reason_code         TEXT NOT NULL CHECK (reason_code IN (
        'PURCHASE_RECEIPT','SALE','RETURN_IN','RETURN_TO_SUPPLIER','COUNT_ADJUST',
        'DAMAGE','THEFT','TRANSFER','OPENING_BALANCE','EXCHANGE_OUT','EXCHANGE_IN'
    )),
    ref_type            TEXT,
    ref_id              TEXT,
    note                TEXT,
    user_id             TEXT NOT NULL,
    FOREIGN KEY (variant_id) REFERENCES product_variant(id),
    FOREIGN KEY (from_location_id) REFERENCES location(id),
    FOREIGN KEY (to_location_id) REFERENCES location(id)
);
CREATE INDEX stock_movement_variant ON stock_movement(tenant_id, variant_id, occurred_at);
CREATE INDEX stock_movement_store_time ON stock_movement(tenant_id, store_id, occurred_at);
CREATE INDEX stock_movement_ref ON stock_movement(ref_type, ref_id);

CREATE TABLE stock_level (
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    location_id         TEXT NOT NULL,
    variant_id          TEXT NOT NULL,
    qty_on_hand         INTEGER NOT NULL DEFAULT 0,
    qty_reserved        INTEGER NOT NULL DEFAULT 0,
    avg_cost_minor      INTEGER NOT NULL DEFAULT 0,
    last_movement_at    INTEGER,
    PRIMARY KEY (tenant_id, location_id, variant_id)
);
CREATE INDEX stock_level_variant ON stock_level(tenant_id, variant_id);

CREATE TABLE stock_count (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    location_id         TEXT NOT NULL,
    status              TEXT NOT NULL CHECK (status IN ('DRAFT','COUNTING','POSTED')),
    started_at          INTEGER NOT NULL,
    posted_at           INTEGER,
    user_id             TEXT NOT NULL,
    note                TEXT,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (location_id) REFERENCES location(id)
);
CREATE INDEX stock_count_store ON stock_count(tenant_id, store_id, status);

CREATE TABLE stock_count_line (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    stock_count_id      TEXT NOT NULL,
    variant_id          TEXT NOT NULL,
    snapshot_qty        INTEGER NOT NULL,
    counted_qty         INTEGER,
    variance_qty        INTEGER,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (stock_count_id) REFERENCES stock_count(id),
    FOREIGN KEY (variant_id) REFERENCES product_variant(id)
);
CREATE INDEX stock_count_line_count ON stock_count_line(stock_count_id);

-- ============================================================================
-- Sales, returns, exchanges
-- ============================================================================

CREATE TABLE sale (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    doc_type            TEXT NOT NULL CHECK (doc_type IN ('SALE','RETURN','EXCHANGE')),
    doc_number          TEXT NOT NULL,
    status              TEXT NOT NULL CHECK (status IN ('DRAFT','COMPLETED','VOIDED')),
    original_sale_id    TEXT,
    customer_id         TEXT,
    channel_code        TEXT NOT NULL CHECK (channel_code IN ('RETAIL','WHOLESALE','STAFF','ONLINE')),
    shift_id            TEXT,
    user_id             TEXT NOT NULL,
    location_id         TEXT NOT NULL,
    occurred_at         INTEGER NOT NULL,
    completed_at        INTEGER,
    voided_at           INTEGER,
    void_reason         TEXT,
    subtotal_minor      INTEGER NOT NULL DEFAULT 0,
    discount_minor      INTEGER NOT NULL DEFAULT 0,
    tax_minor           INTEGER NOT NULL DEFAULT 0,
    total_minor         INTEGER NOT NULL DEFAULT 0,
    paid_minor          INTEGER NOT NULL DEFAULT 0,
    balance_minor       INTEGER NOT NULL DEFAULT 0,
    currency_code       TEXT NOT NULL,
    note                TEXT,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (original_sale_id) REFERENCES sale(id),
    FOREIGN KEY (location_id) REFERENCES location(id)
);
CREATE UNIQUE INDEX sale_tenant_doc_number ON sale(tenant_id, doc_number);
CREATE INDEX sale_store_time_status ON sale(tenant_id, store_id, completed_at, status);
CREATE INDEX sale_customer ON sale(tenant_id, customer_id);
CREATE INDEX sale_shift ON sale(shift_id);

CREATE TABLE sale_line (
    id                      TEXT PRIMARY KEY NOT NULL,
    tenant_id               TEXT NOT NULL,
    sale_id                 TEXT NOT NULL,
    line_no                 INTEGER NOT NULL,
    variant_id              TEXT NOT NULL,
    qty                     INTEGER NOT NULL,
    unit_price_minor        INTEGER NOT NULL,
    price_list_id           TEXT,
    discount_type           TEXT CHECK (discount_type IN ('AMOUNT','PERCENT')),
    discount_value          INTEGER,
    discount_minor          INTEGER NOT NULL DEFAULT 0,
    tax_rate_bp             INTEGER NOT NULL DEFAULT 0,
    tax_minor               INTEGER NOT NULL DEFAULT 0,
    line_total_minor        INTEGER NOT NULL,
    unit_cost_snapshot_minor INTEGER NOT NULL DEFAULT 0,
    origin_sale_line_id     TEXT,
    currency_code           TEXT NOT NULL,
    created_at              INTEGER NOT NULL,
    updated_at              INTEGER NOT NULL,
    deleted_at              INTEGER,
    revision                INTEGER NOT NULL DEFAULT 1,
    origin_device_id        TEXT NOT NULL,
    server_seq               INTEGER,
    FOREIGN KEY (sale_id) REFERENCES sale(id),
    FOREIGN KEY (variant_id) REFERENCES product_variant(id),
    FOREIGN KEY (origin_sale_line_id) REFERENCES sale_line(id)
);
CREATE INDEX sale_line_sale ON sale_line(sale_id);
CREATE INDEX sale_line_origin ON sale_line(origin_sale_line_id);

CREATE TABLE payment (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    sale_id             TEXT NOT NULL,
    method_code         TEXT NOT NULL CHECK (method_code IN (
        'CASH','CARD','BANK_TRANSFER','MOBILE_MONEY','STORE_CREDIT','CUSTOMER_CREDIT'
    )),
    amount_minor        INTEGER NOT NULL,
    currency_code       TEXT NOT NULL,
    direction           TEXT NOT NULL CHECK (direction IN ('IN','OUT')),
    reference           TEXT,
    tendered_minor      INTEGER,
    change_minor        INTEGER,
    user_id             TEXT NOT NULL,
    FOREIGN KEY (sale_id) REFERENCES sale(id)
);
CREATE INDEX payment_sale ON payment(sale_id);
CREATE INDEX payment_store_time ON payment(tenant_id, store_id, created_at);

-- ============================================================================
-- Customers and receivables
-- ============================================================================

CREATE TABLE customer (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    code                TEXT NOT NULL,
    name                TEXT NOT NULL,
    phone               TEXT,
    alt_phone           TEXT,
    address             TEXT,
    tax_number          TEXT,
    notes               TEXT,
    credit_limit_minor  INTEGER NOT NULL DEFAULT 0,
    price_list_id       TEXT,
    is_active           INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (price_list_id) REFERENCES price_list(id)
);
CREATE UNIQUE INDEX customer_tenant_code ON customer(tenant_id, code);
CREATE INDEX customer_phone ON customer(tenant_id, phone);

CREATE TABLE customer_ledger (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    customer_id         TEXT NOT NULL,
    entry_type          TEXT NOT NULL CHECK (entry_type IN ('CHARGE','PAYMENT','REFUND','ADJUSTMENT','WRITE_OFF')),
    amount_minor        INTEGER NOT NULL,
    currency_code       TEXT NOT NULL,
    ref_type            TEXT,
    ref_id              TEXT,
    occurred_at         INTEGER NOT NULL,
    user_id             TEXT NOT NULL,
    note                TEXT,
    FOREIGN KEY (customer_id) REFERENCES customer(id)
);
CREATE INDEX customer_ledger_customer ON customer_ledger(tenant_id, customer_id, occurred_at);

CREATE TABLE customer_balance (
    tenant_id           TEXT NOT NULL,
    customer_id         TEXT NOT NULL,
    balance_minor       INTEGER NOT NULL DEFAULT 0,
    last_entry_at       INTEGER,
    oldest_unpaid_at    INTEGER,
    PRIMARY KEY (tenant_id, customer_id)
);

-- ============================================================================
-- Suppliers and purchasing
-- ============================================================================

CREATE TABLE supplier (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    code                TEXT NOT NULL,
    name                TEXT NOT NULL,
    phone               TEXT,
    address             TEXT,
    payment_terms_days  INTEGER NOT NULL DEFAULT 0,
    currency_code       TEXT NOT NULL,
    notes               TEXT,
    is_active           INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER
);
CREATE UNIQUE INDEX supplier_tenant_code ON supplier(tenant_id, code);

CREATE TABLE purchase_order (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    supplier_id         TEXT NOT NULL,
    po_number           TEXT NOT NULL,
    status              TEXT NOT NULL CHECK (status IN ('DRAFT','ORDERED','PARTIALLY_RECEIVED','RECEIVED','CANCELLED')),
    ordered_at          INTEGER,
    expected_at         INTEGER,
    location_id         TEXT NOT NULL,
    subtotal_minor      INTEGER NOT NULL DEFAULT 0,
    discount_minor      INTEGER NOT NULL DEFAULT 0,
    shipping_minor      INTEGER NOT NULL DEFAULT 0,
    other_cost_minor    INTEGER NOT NULL DEFAULT 0,
    total_minor         INTEGER NOT NULL DEFAULT 0,
    currency_code       TEXT NOT NULL,
    note                TEXT,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (supplier_id) REFERENCES supplier(id),
    FOREIGN KEY (location_id) REFERENCES location(id)
);
CREATE UNIQUE INDEX purchase_order_tenant_number ON purchase_order(tenant_id, po_number);
CREATE INDEX purchase_order_supplier ON purchase_order(tenant_id, supplier_id, status);

CREATE TABLE purchase_order_line (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    purchase_order_id   TEXT NOT NULL,
    line_no             INTEGER NOT NULL,
    variant_id          TEXT NOT NULL,
    qty_ordered         INTEGER NOT NULL,
    qty_received        INTEGER NOT NULL DEFAULT 0,
    unit_cost_minor     INTEGER NOT NULL,
    discount_minor      INTEGER NOT NULL DEFAULT 0,
    line_total_minor    INTEGER NOT NULL,
    currency_code       TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (purchase_order_id) REFERENCES purchase_order(id),
    FOREIGN KEY (variant_id) REFERENCES product_variant(id)
);
CREATE INDEX purchase_order_line_po ON purchase_order_line(purchase_order_id);

CREATE TABLE goods_receipt (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    purchase_order_id   TEXT,
    receipt_number      TEXT NOT NULL,
    location_id         TEXT NOT NULL,
    received_at         INTEGER NOT NULL,
    user_id             TEXT NOT NULL,
    note                TEXT,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (purchase_order_id) REFERENCES purchase_order(id),
    FOREIGN KEY (location_id) REFERENCES location(id)
);
CREATE UNIQUE INDEX goods_receipt_tenant_number ON goods_receipt(tenant_id, receipt_number);
CREATE INDEX goods_receipt_po ON goods_receipt(purchase_order_id);

CREATE TABLE goods_receipt_line (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    goods_receipt_id    TEXT NOT NULL,
    purchase_order_line_id TEXT,
    variant_id          TEXT NOT NULL,
    qty                 INTEGER NOT NULL,
    unit_cost_minor     INTEGER NOT NULL,
    currency_code       TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (goods_receipt_id) REFERENCES goods_receipt(id),
    FOREIGN KEY (purchase_order_line_id) REFERENCES purchase_order_line(id),
    FOREIGN KEY (variant_id) REFERENCES product_variant(id)
);
CREATE INDEX goods_receipt_line_receipt ON goods_receipt_line(goods_receipt_id);

CREATE TABLE supplier_return (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    supplier_id         TEXT NOT NULL,
    return_number       TEXT NOT NULL,
    location_id         TEXT NOT NULL,
    returned_at         INTEGER NOT NULL,
    user_id             TEXT NOT NULL,
    note                TEXT,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (supplier_id) REFERENCES supplier(id),
    FOREIGN KEY (location_id) REFERENCES location(id)
);
CREATE UNIQUE INDEX supplier_return_tenant_number ON supplier_return(tenant_id, return_number);

CREATE TABLE supplier_return_line (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    supplier_return_id  TEXT NOT NULL,
    variant_id          TEXT NOT NULL,
    qty                 INTEGER NOT NULL,
    unit_cost_minor     INTEGER NOT NULL,
    currency_code       TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    FOREIGN KEY (supplier_return_id) REFERENCES supplier_return(id),
    FOREIGN KEY (variant_id) REFERENCES product_variant(id)
);
CREATE INDEX supplier_return_line_return ON supplier_return_line(supplier_return_id);

CREATE TABLE supplier_ledger (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    supplier_id         TEXT NOT NULL,
    entry_type          TEXT NOT NULL CHECK (entry_type IN ('CHARGE','PAYMENT','REFUND','ADJUSTMENT','WRITE_OFF')),
    amount_minor        INTEGER NOT NULL,
    currency_code       TEXT NOT NULL,
    ref_type            TEXT,
    ref_id              TEXT,
    occurred_at         INTEGER NOT NULL,
    user_id             TEXT NOT NULL,
    note                TEXT,
    FOREIGN KEY (supplier_id) REFERENCES supplier(id)
);
CREATE INDEX supplier_ledger_supplier ON supplier_ledger(tenant_id, supplier_id, occurred_at);

-- ============================================================================
-- Cash drawer and shifts
-- ============================================================================

CREATE TABLE shift (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    opened_by_user_id   TEXT NOT NULL,
    opened_at           INTEGER NOT NULL,
    opening_float_minor INTEGER NOT NULL DEFAULT 0,
    closed_by_user_id   TEXT,
    closed_at           INTEGER,
    counted_cash_minor  INTEGER,
    expected_cash_minor INTEGER,
    variance_minor      INTEGER,
    status              TEXT NOT NULL CHECK (status IN ('OPEN','CLOSED')),
    note                TEXT,
    currency_code       TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    revision            INTEGER NOT NULL DEFAULT 1,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER
);
-- Only one OPEN shift per store at a time.
CREATE UNIQUE INDEX shift_one_open_per_store ON shift(tenant_id, store_id) WHERE status = 'OPEN';
CREATE INDEX shift_store_time ON shift(tenant_id, store_id, opened_at);

CREATE TABLE cash_movement (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    created_at          INTEGER NOT NULL,
    origin_device_id    TEXT NOT NULL,
    server_seq          INTEGER,
    shift_id            TEXT NOT NULL,
    kind                TEXT NOT NULL CHECK (kind IN ('OPENING_FLOAT','SALE_CASH','REFUND_CASH','PAY_IN','PAY_OUT','DROP','CLOSING_COUNT')),
    amount_minor        INTEGER NOT NULL,
    currency_code       TEXT NOT NULL,
    reason              TEXT,
    user_id             TEXT NOT NULL,
    FOREIGN KEY (shift_id) REFERENCES shift(id)
);
CREATE INDEX cash_movement_shift ON cash_movement(shift_id);

-- ============================================================================
-- Audit log
-- ============================================================================

CREATE TABLE audit_event (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    occurred_at         INTEGER NOT NULL,
    user_id             TEXT NOT NULL,
    device_id           TEXT NOT NULL,
    entity_type         TEXT NOT NULL,
    entity_id           TEXT NOT NULL,
    action               TEXT NOT NULL,
    summary_json        TEXT NOT NULL,
    before_json         TEXT,
    after_json          TEXT,
    reason              TEXT,
    ip_or_host          TEXT,
    server_seq          INTEGER
);
CREATE INDEX audit_event_entity ON audit_event(entity_type, entity_id, occurred_at);
CREATE INDEX audit_event_store_time ON audit_event(tenant_id, store_id, occurred_at);
CREATE INDEX audit_event_user ON audit_event(tenant_id, user_id, occurred_at);

-- ============================================================================
-- Sync scaffolding — written from v1, consumed starting Phase 4 (ADR-007)
-- ============================================================================

CREATE TABLE outbox_entry (
    id                  TEXT PRIMARY KEY NOT NULL,
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    entity_table        TEXT NOT NULL,
    entity_id           TEXT NOT NULL,
    op                  TEXT NOT NULL CHECK (op IN ('INSERT','UPDATE','DELETE')),
    entity_updated_at   INTEGER NOT NULL,
    created_at          INTEGER NOT NULL,
    status              TEXT NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING','SENDING','SENT','FAILED')),
    attempt_count       INTEGER NOT NULL DEFAULT 0,
    last_error          TEXT,
    batch_id            TEXT
);
CREATE INDEX outbox_entry_status ON outbox_entry(status, created_at);
CREATE INDEX outbox_entry_entity ON outbox_entry(entity_table, entity_id);

CREATE TABLE sync_state (
    table_name              TEXT PRIMARY KEY NOT NULL,
    last_pulled_server_seq  INTEGER NOT NULL DEFAULT 0,
    last_pulled_at          INTEGER,
    last_pushed_at          INTEGER,
    last_error              TEXT
);

CREATE TABLE sync_conflict (
    id                  TEXT PRIMARY KEY NOT NULL,
    entity_table        TEXT NOT NULL,
    entity_id           TEXT NOT NULL,
    local_json          TEXT NOT NULL,
    remote_json         TEXT NOT NULL,
    resolution          TEXT,
    resolved_at         INTEGER,
    resolved_by         TEXT
);
CREATE INDEX sync_conflict_entity ON sync_conflict(entity_table, entity_id);

-- ============================================================================
-- Reference / supporting tables
-- ============================================================================

CREATE TABLE currency (
    code                    TEXT PRIMARY KEY NOT NULL,
    minor_unit_exponent     INTEGER NOT NULL,
    symbol_ar               TEXT NOT NULL,
    symbol_en               TEXT NOT NULL
);

CREATE TABLE setting (
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    key                 TEXT NOT NULL,
    value_json          TEXT NOT NULL,
    PRIMARY KEY (tenant_id, store_id, key)
);

CREATE TABLE document_counter (
    tenant_id           TEXT NOT NULL,
    store_id            TEXT NOT NULL,
    doc_type            TEXT NOT NULL,
    prefix              TEXT NOT NULL,
    next_value          INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (tenant_id, store_id, doc_type)
);

CREATE TABLE backup_log (
    id                  TEXT PRIMARY KEY NOT NULL,
    started_at          INTEGER NOT NULL,
    finished_at         INTEGER,
    path                TEXT NOT NULL,
    size_bytes          INTEGER,
    verify_result       TEXT CHECK (verify_result IN ('OK','FAILED') OR verify_result IS NULL),
    trigger             TEXT NOT NULL CHECK (trigger IN ('SCHEDULED','MANUAL','PRE_MIGRATION','ON_CLOSE'))
);
CREATE INDEX backup_log_started ON backup_log(started_at);
